# Copy to backend/.env and fill in your own database values.
# Never commit the populated .env file.
# Backend secrets belong here, not in frontend VITE_* variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

APP_NAME=Student Mapping API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_LOCAL_FILE_PATHS=true
# Maximum accepted browser upload/local-path file size in bytes (default: 100 MiB).
MAX_UPLOAD_BYTES=104857600
# Production requires HTTPS and secure cookies. Set false only for local HTTP development.
SESSION_COOKIE_SECURE=true
# Use none only when frontend and backend are on different sites; it requires secure=true.
# Subdomains such as app.example.com and api.example.com can normally keep lax.
SESSION_COOKIE_SAMESITE=lax
