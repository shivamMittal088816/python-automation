  "cards": [
    {
      "dot": "cyan",
      "title": "Browser interaction",
      "items": [
        "React Router pages; shared mapping context; separate bulk workspace.",
        "Cookie credentials + X-Workspace-Revision; cross-tab refresh notifications.",
        "Read-only Matched / Review / Not Matched previews; CSV/XLSX downloads."
      ]
    },
    {
      "dot": "emerald",
      "title": "Mapping and file processing",
      "items": [
        "Routes read frames, run Python mapping, then persist grouped workbooks.",
        "Email can use school or Admission misses; Name+Class also accepts Email misses.",
        "pandas/openpyxl parse and export; combined results workbook built on download."
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence and scope",
      "items": [
        "Separate mapping / bulk disk workspaces; 24-hour idle expiry and process-local locks.",
        "Mapping uses state.json + hash-named .bin snapshots; parser staging is removed.",
        "SQLAlchemy/PyMySQL reads; no inferred cloud topology or runtime Archify service."
      ]
    }
  ]
